      "master":   {"param": "TODO Master",    "as": "text"},
      "bright":   {"param": "TODO Bright",    "as": "text"},
      "inputPad": {"param": "TODO -15dB",     "as": "text"},
      "ultraHi":  {"param": "TODO Hi",        "as": "text"},
      "ultraLo":  {"param": "TODO Lo",        "as": "text"},
      "geqOn":    {"param": "TODO EQ",        "as": "text"},
      "geq33":    {"param": "TODO 33",        "as": "text"},
      "geq80":    {"param": "TODO 80",        "as": "text"},
      "geq150":   {"param": "TODO 150",       "as": "text"},

{
  "_help": [
    "How each plugin's parameters map onto the shared faceplate keys used by cases.py.",
    "as = 'knob10': faceplate 0-10 -> normalised value/10 (--set)",
    "as = 'text'  : value passed as display text (--set-text); booleans become On/Off",
    "as = 'norm'  : value is already normalised 0-1 (--set)",
    "as = 'points': piecewise-linear [[faceplate, normalised], ...] (--set); for plugins whose text parsing is broken",
    "baseline = settings applied to every render: strings as display text, numbers as normalised values.",
    "Reference entries marked TODO must be checked with: AmpBassHostRender --plugin <path> --list / --probe <name>"
  ],
  "ampbass": {
    "path": "~/Library/Audio/Plug-Ins/VST3/AmpBass.vst3",
    "baseline": {
      "Input Select": 1.0,
      "Dry/Wet": 1.0,
      "Cabinet": 0.0,
      "Tight": 0.0,
      "Power Soak": 1.0
    },
    "map": {
      "gain":     {"param": "Gain",          "as": "knob10"},
      "tubeGain": {"param": "Tube Gain",     "as": "knob10"},
      "bass":     {"param": "Bass",          "as": "knob10"},
      "midrange": {"param": "Midrange",      "as": "knob10"},
      "midFreq":  {"param": "Mid Frequency", "as": "text"},
      "treble":   {"param": "Treble",        "as": "knob10"},
      "master":   {"param": "Master Volume", "as": "knob10"},
      "bright":   {"param": "Bright",        "as": "text"},
      "inputPad": {"param": "Input Pad",     "as": "text"},
      "ultraHi":  {"param": "Ultra Hi",      "as": "text"},
      "ultraLo":  {"param": "Ultra Lo",      "as": "text"},
      "geqOn":    {"param": "Graphic EQ On", "as": "text"},
      "geq33":    {"param": "GEQ 33 Hz",     "as": "text"},
      "geq80":    {"param": "GEQ 80 Hz",     "as": "text"},
      "geq150":   {"param": "GEQ 150 Hz",    "as": "text"},
      "geq300":   {"param": "GEQ 300 Hz",    "as": "text"},
      "geq600":   {"param": "GEQ 600 Hz",    "as": "text"},
      "geq900":   {"param": "GEQ 900 Hz",    "as": "text"},
      "geq2k":    {"param": "GEQ 2 kHz",     "as": "text"},
      "geq5k":    {"param": "GEQ 5 kHz",     "as": "text"},
      "geq9k":    {"param": "GEQ 8 kHz",     "as": "text"},
      "geqLevel": {"param": "GEQ Level",     "as": "text"}
    }
  },
  "reference": {
    "path": "/Library/Audio/Plug-Ins/VST3/Ampeg SVT3Pro.vst3",
    "baseline": {
      "RecChain": 1.0,
      "Horn": 0.0,
      "NgByPass": 0.0,
      "NgThres": 0.0,
      "Tight": 0.0,
      "Smooth": 0.0,
      "Input": 0.5,
      "PowerSoak": 1.0
    },
    "map": {
      "gain":     {"param": "Gain",      "as": "knob10"},
      "tubeGain": {"param": "TubeGain",  "as": "knob10"},
      "bass":     {"param": "Bass",      "as": "knob10"},
      "midrange": {"param": "Mid",       "as": "knob10"},
      "treble":   {"param": "Treble",    "as": "knob10"},
      "master":   {"param": "Master",    "as": "knob10"},
      "bright":   {"param": "Bright",    "as": "norm"},
      "inputPad": {"param": "InpAtt",    "as": "norm"},
      "ultraHi":  {"param": "High",      "as": "norm"},
      "ultraLo":  {"param": "Low",       "as": "norm"},
      "geqOn":    {"param": "EQPower",   "as": "norm"},
      "midFreq":  {"param": "MidFreq",   "as": "points", "points": [[1, 0], [5, 1]]},
      "geq33":    {"param": "EqB1",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq80":    {"param": "EqB2",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq150":   {"param": "EqB3",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq300":   {"param": "EqB4",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq600":   {"param": "EqB5",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq900":   {"param": "EqB6",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq2k":    {"param": "EqB7",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq5k":    {"param": "EqB8",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geq9k":    {"param": "EqB9",      "as": "points", "points": [[-12, 0], [12, 1]]},
      "geqLevel": {"param": "EqLevel",   "as": "points", "points": [[-10, 0], [0, 0.5], [8, 1]]}
    }
  }
}
